---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHeader from '../../components/PageHeader.astro'; import PostCard from '../../components/PostCard.astro'; import { sortPosts } from '../../utils/posts';
export async function getStaticPaths(){ const posts=sortPosts(await getCollection('blog')); return [...new Set(posts.flatMap(p=>p.data.tags))].map(tag=>({params:{tag},props:{tag,posts:posts.filter(p=>p.data.tags.includes(tag))}})); } const {tag,posts}=Astro.props;
---
<BaseLayout title={`标签：${tag}`}><PageHeader eyebrow="TAG" title={`#${tag}`} description={`共 ${posts.length} 篇文章`} /><section class="shell section no-top list-stack">{posts.map((p)=><PostCard post={p} />)}</section></BaseLayout>
