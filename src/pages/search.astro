---
import { getCollection } from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro'; import PageHeader from '../components/PageHeader.astro'; import { sortPosts, formatDate } from '../utils/posts';
const posts=sortPosts(await getCollection('blog'));
---
<BaseLayout title="搜索"><PageHeader eyebrow="SEARCH" title="搜索文章" description="按标题、描述、标签或分类查找。" /><section class="shell section no-top"><label class="search-box"><span class="sr-only">搜索关键词</span><input id="search-input" type="search" placeholder="试试：Java、学习、生活…" autocomplete="off" /><kbd>/</kbd></label><p id="search-status" class="search-status" aria-live="polite">共 {posts.length} 篇文章</p><div id="search-results" class="search-results">{posts.map(p=><article data-search={`${p.data.title} ${p.data.description} ${p.data.category} ${p.data.tags.join(' ')}`.toLowerCase()}><time>{formatDate(p.data.date)}</time><div><h2><a href={`/posts/${p.id}/`}>{p.data.title}</a></h2><p>{p.data.description}</p><span>{p.data.category} · {p.data.tags.join(' / ')}</span></div></article>)}</div><div id="empty-search" class="empty-state" hidden><strong>没有找到匹配的文章</strong><p>换一个更短或更宽泛的关键词试试。</p></div></section>
<script>const input=document.querySelector<HTMLInputElement>('#search-input');const cards=[...document.querySelectorAll<HTMLElement>('[data-search]')];const status=document.querySelector('#search-status');const empty=document.querySelector<HTMLElement>('#empty-search');function filter(){const q=input?.value.trim().toLowerCase()||'';let count=0;cards.forEach(card=>{const show=(card.dataset.search||'').includes(q);card.hidden=!show;if(show)count++});if(status)status.textContent=q?`找到 ${count} 篇文章`:`共 ${count} 篇文章`;if(empty)empty.hidden=count>0}input?.addEventListener('input',filter);addEventListener('keydown',(e)=>{if(e.key==='/'&&document.activeElement!==input){e.preventDefault();input?.focus()}});</script></BaseLayout>
