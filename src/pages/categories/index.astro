---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHeader from '../../components/PageHeader.astro'; import { sortPosts } from '../../utils/posts';
const posts = sortPosts(await getCollection('blog')); const groups = Object.entries(Object.groupBy(posts, (p) => p.data.category)).sort((a,b) => (b[1]?.length ?? 0)-(a[1]?.length ?? 0));
---
<BaseLayout title="分类"><PageHeader eyebrow="CATEGORIES" title="分类" description="从主题进入，找到同一条学习或生活线索。" /><section class="shell section no-top group-grid">{groups.map(([name, items]) => <a class="group-card" href={`/categories/${encodeURIComponent(name)}/`}><span>{String(items?.length ?? 0).padStart(2,'0')}</span><h2>{name}</h2><p>{items?.map((p) => p.data.title).slice(0,2).join(' · ')}</p></a>)}</section></BaseLayout>
