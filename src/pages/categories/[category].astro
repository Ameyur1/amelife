---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHeader from '../../components/PageHeader.astro'; import PostCard from '../../components/PostCard.astro'; import { sortPosts } from '../../utils/posts';
export async function getStaticPaths(){ const posts=sortPosts(await getCollection('blog')); return [...new Set(posts.map(p=>p.data.category))].map(category=>({params:{category},props:{category,posts:posts.filter(p=>p.data.category===category)}})); }
const { category, posts } = Astro.props;
---
<BaseLayout title={`分类：${category}`}><PageHeader eyebrow="CATEGORY" title={category} description={`共 ${posts.length} 篇文章`} /><section class="shell section no-top list-stack">{posts.map((p) => <PostCard post={p} />)}</section></BaseLayout>
