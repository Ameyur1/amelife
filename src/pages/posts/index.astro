---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHeader from '../../components/PageHeader.astro'; import PostCard from '../../components/PostCard.astro'; import { sortPosts } from '../../utils/posts';
const posts = sortPosts(await getCollection('blog'));
---
<BaseLayout title="文章" description="Amelife 的全部文章"><PageHeader eyebrow="WRITING" title="文章" description="技术、学习与生活，按写下它们的时间排列。" /><section class="shell section no-top"><div class="list-stack">{posts.map((post) => <PostCard post={post} />)}</div></section></BaseLayout>
