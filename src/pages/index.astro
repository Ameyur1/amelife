---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config';
import { getPostCover, sortPosts } from '../utils/posts';

const posts = sortPosts(await getCollection('blog'));
const latest = posts[0];
const bgStyle = `--hero-light:url(${siteConfig.backgrounds.light});--hero-dark:url(${siteConfig.backgrounds.dark});--overlay-light:${siteConfig.backgrounds.overlayLight};--overlay-dark:${siteConfig.backgrounds.overlayDark}`;
const chapters = [
  { index: '01', label: '文章', sub: 'WRITING ARCHIVE', href: '/posts/', image: getPostCover(latest), detail: latest.data.title, meta: `${posts.length} NOTES`, action: '开始阅读' },
  { index: '02', label: '分类', sub: 'THREE SECTORS', href: '/categories/', image: '/images/posts/category-essay.jpg', detail: '学术 / 杂谈 / 日常', meta: '03 SECTORS', action: '进入分类' },
  { index: '03', label: '标签', sub: 'SIGNAL MAP', href: '/tags/', image: '/images/posts/category-academic.jpg', detail: '沿关键词寻找内容', meta: 'TAG MATRIX', action: '查看标签' },
  { index: '04', label: '归档', sub: 'TIME LINE', href: '/archive/', image: '/images/posts/category-daily.jpeg', detail: '按时间回看记录', meta: '2026 / NOW', action: '打开归档' },
  { index: '05', label: '项目', sub: 'SIDE QUESTS', href: '/projects/', image: '/images/projects/project-map.svg', detail: '正在做的小东西', meta: '03 PROJECTS', action: '查看项目' },
  { index: '06', label: '关于', sub: 'PLAYER DATA', href: '/about/', image: siteConfig.avatar, detail: 'Ameyur1 / BUPT', meta: 'PROFILE', action: '读取资料' },
];
---
<BaseLayout>
  <section class="chapter-screen" style={bgStyle} aria-label="网站板块选择">
    <div class="chapter-topbar shell"><span>AMELIFE / CHAPTER SELECT</span><strong>{new Date().getFullYear()}</strong><i>DATA ONLINE</i></div>
    <div class="chapter-deck" data-chapter-deck>
      {chapters.map((chapter, index) => (
        <a class:list={['chapter-card', index === 0 && 'is-selected']} href={chapter.href} data-chapter-card style={`--chapter-image:url('${chapter.image}')`} aria-label={`${chapter.label}：${chapter.detail}`}>
          <span class="chapter-number">{chapter.index}</span>
          <div class="chapter-art" aria-hidden="true"></div><div class="chapter-shade" aria-hidden="true"></div>
          <div class="chapter-copy"><small>{chapter.sub}</small><h2>{chapter.label}</h2><p>{chapter.detail}</p></div>
          <div class="chapter-stats"><span>{chapter.meta}</span><i></i><span>READY</span></div>
          <span class="chapter-play"><b>▷</b>{chapter.action}</span>
        </a>
      ))}
    </div>
    <div class="chapter-footer shell"><div><span>06</span><small>TOTAL CHAPTERS</small></div><div><span>{String(posts.length).padStart(2, '0')}</span><small>RECORDS</small></div><p>移动光标选择板块 / 点击进入</p></div>
  </section>
</BaseLayout>
<script>
  const cards = [...document.querySelectorAll<HTMLElement>('[data-chapter-card]')];
  const select = (card: HTMLElement) => cards.forEach((item) => item.classList.toggle('is-selected', item === card));
  cards.forEach((card) => { card.addEventListener('pointerenter', () => select(card)); card.addEventListener('focus', () => select(card)); });
</script>
